# ─────────────────────────────────────────────────────────────────────────────
#  EventSphere Backend — Environment Variables
#  Copy: cp .env.example .env  →  fill in values  →  restart server
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/eventsphere
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/eventsphere
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── Email (Nodemailer / Gmail) ────────────────────────────────────────────────
# Use a Gmail App Password — NOT your account password.
# Enable 2FA → myaccount.google.com/apppasswords → create "Mail" password
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# ══════════════════════════════════════════════════════════════════════════════
#  WHATSAPP - optional Meta Cloud API integration
#
#  Disabled by default so the project does not use Facebook/Meta.
#  In-app notifications still work, and SMS works when SMS_ENABLED=true.
#
#  Pricing if you enable Meta later:
#    • First 1,000 conversations/month → FREE
#    • After that: ~₹0.35 per conversation (India)
#
#  One-time setup (~30 min):
#    1. https://developers.facebook.com → My Apps → Create App → Business
#    2. Add "WhatsApp" product to the app
#    3. WhatsApp > API Setup:
#         Copy "Temporary access token"  → META_WHATSAPP_TOKEN
#         Copy "Phone number ID"         → META_PHONE_NUMBER_ID
#    4. Verify a test recipient number in the dashboard
#    5. For production: create a permanent System User token in Business Settings
# ══════════════════════════════════════════════════════════════════════════════
# Keep this false if you do not want to use Facebook/Meta.
WHATSAPP_ENABLED=false
# META_WHATSAPP_TOKEN=your_meta_access_token_here
# META_PHONE_NUMBER_ID=your_phone_number_id_here

# ══════════════════════════════════════════════════════════════════════════════
#  SMS (optional mobile notifications)
# ══════════════════════════════════════════════════════════════════════════════
SMS_ENABLED=true

# Twilio SMS: paid
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_SMS_FROM=+1XXXXXXXXXX

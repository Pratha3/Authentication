PORT=5000

# MongoDB — change DB name from authDB to eventsphere
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere

# JWT — use a long random secret in production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend origin (CORS + password reset links)
CLIENT_URL=http://localhost:3000

# Backend public URL used for uploaded file URLs
BACKEND_URL=http://localhost:5000

# Email (optional — nodemailer password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
